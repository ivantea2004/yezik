{
    "scopeName": "source.yezik",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#integers"
        },
        {
            "include": "#chars"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords-operators"
        },
        {
            "include": "#keywords-control"
        },
        {
            "include": "#keywords-declarators"
        },
        {
            "include": "#builtin-types"
        },
        {
            "include": "#builtin-constants"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "comments": {
            "name": "comment.line.number-sign",
            "begin": "#",
            "end": "\n"
        },
        "identifiers": {
            "name": "variable.other",
            "match": "\\b(\\w+)\\b"
        },
        "integers": {
            "name": "constant.numeric",
            "match": "\\b([0-9]+)\\b"
        },
        "chars": {
            "name": "string.quoted.double",
            "begin": "'",
            "end": "'",
            "patterns": [
                {
                    "name": "constant.character.escape",
                    "match": "\\\\."
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape",
                    "match": "\\\\."
                }
            ]
        },
        "keywords-operators": {
            "name": "keyword.other",
            "match": "\\b(cast|not|and|or|size_of)\\b"
        },
        "keywords-control": {
            "name": "keyword.control",
            "match": "\\b(if|elif|else|while|break|continue|return)\\b"
        },
        "keywords-declarators": {
            "name": "storage.type",
            "match": "\\b(let|const|record|enum|import)\\b"
        },
        "builtin-types": {
            "name": "storage.type",
            "match": "\\b(type|void|bool|char|ptr|isize|usize|s8|u8|s16|u16|s32|u32|s64|u64|c_int|str)\\b"
        },
        "builtin-constants": {
            "name": "constant.language",
            "match": "\\b(true|false|null|undefined)\\b"
        }
    }
}