{
    "folders": [
        {
            "path": ".."
        }
    ],
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "type": "cppbuild",
                "label": "Build transpiler",
                "command": "cmd",
                "args": [
                    "/c",
                    "build.bat",
                    "--transpiler-only",
                    "clang",
                    "-std=c89 -pedantic -g -Og -Wall -Wextra -Werror -D_CRT_SECURE_NO_WARNINGS"
                ],
                "problemMatcher": [
                    "$gcc"
                ],
                "group": {
                    "kind": "build",
                    "isDefault": true
                },
            },
            {
                "type": "cppbuild",
                "label": "Build",
                "command": "cmd",
                "args": [
                    "/c",
                    "build.bat",
                    "main.yezik",
                    "build/out.exe",
                    "clang",
                    "-std=c89 -pedantic -g -Og -Wall -Wextra -Werror -D_CRT_SECURE_NO_WARNINGS"
                ],
                "problemMatcher": [
                    "$gcc"
                ],
                "group": {
                    "kind": "build",
                    "isDefault": true
                },
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Run transpiler",
                "type": "cppvsdbg",
                "request": "launch",
                "cwd": "${workspaceFolder}",
                "program": "build/bootstrap-transpiler.exe",
                "args": [
                    "main.yezik",
                    "build/out.exe.c"
                ],
                "preLaunchTask": "Build transpiler"
            },
            {
                "name": "Run",
                "type": "cppvsdbg",
                "request": "launch",
                "cwd": "${workspaceFolder}",
                "program": "build/out.exe",
                "args": [],
                "preLaunchTask": "Build"
            },
        ]
    },
    "settings": {}
}