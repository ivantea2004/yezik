{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build yezik",
            "command": "gcc",
            "args": [
                "-g",
                "-Og",
                "-O0",
                "-D_CRT_SECURE_NO_WARNINGS",
                "-std=c89",
                "${workspaceFolder}/src/all.c",
                "-o",
                "${workspaceFolder}/build/yezik-bootstrap-transpiler",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-pedantic"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
    ],
}